root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
continuation_indent_size = 8
max_line_length = 120

# =========================================================
# 기본
# =========================================================

# 사람이 의도적으로 만든 줄바꿈 유지
ij_java_keep_line_breaks = true

# 코드 내부의 빈 줄 보존
ij_java_keep_blank_lines_in_code = 1
ij_java_keep_blank_lines_in_declarations = 1
ij_java_keep_blank_lines_before_right_brace = 1

# 짧다고 한 줄로 합치지 않음
ij_java_keep_multiple_expressions_in_one_line = false
ij_java_keep_simple_blocks_in_one_line = false
ij_java_keep_simple_methods_in_one_line = false
ij_java_keep_simple_lambdas_in_one_line = false
ij_java_keep_simple_classes_in_one_line = false

# =========================================================
# Method chaining
# =========================================================

# 체인이 발생하면 각 호출을 한 줄씩
ij_java_method_call_chain_wrap = on_every_item

# 첫 번째 호출까지 무조건 다음 줄로 보내지는 않음
ij_java_wrap_first_method_in_call_chain = false

# '.' 위치를 억지로 세로 정렬하지 않음
ij_java_align_multiline_chained_methods = false

# =========================================================
# if / boolean expression
# =========================================================

# &&, || 등이 긴 경우 각각 줄바꿈
ij_java_binary_operation_wrap = on_every_item

# 연산자를 다음 줄 앞쪽에 배치
ij_java_binary_operation_sign_on_next_line = true

# =========================================================
# Annotation / Array
# =========================================================

# annotation 자체는 필요할 때만 줄바꿈
ij_java_annotation_parameter_wrap = normal

# indexes = { ... } 같은 배열은 각 element를 구분
ij_java_array_initializer_wrap = on_every_item
ij_java_array_initializer_new_line_after_left_brace = true
ij_java_array_initializer_right_brace_on_new_line = true

# =========================================================
# Method arguments / parameters
# =========================================================

# 너무 긴 호출 인자만 적절하게 wrap
ij_java_call_parameters_wrap = normal
ij_java_method_parameters_wrap = normal

# =========================================================
# 기타
# =========================================================

ij_java_assignment_wrap = normal
ij_java_ternary_operation_wrap = normal

[*.{gradle,kts}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.properties]
indent_style = space
indent_size = 2

[*.xml]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf